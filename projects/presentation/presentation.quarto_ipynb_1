        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "np.random.seed(495)\n",
        "\n",
        "# Create simple fake customer data\n",
        "n = 60\n",
        "\n",
        "# Three rough customer groups\n",
        "segment_1 = np.random.normal(loc=[2, 7], scale=[0.7, 0.8], size=(n, 2))   # high engagement\n",
        "segment_2 = np.random.normal(loc=[7, 6], scale=[0.8, 0.7], size=(n, 2))   # high spending\n",
        "segment_3 = np.random.normal(loc=[5, 2], scale=[0.8, 0.7], size=(n, 2))   # low engagement\n",
        "\n",
        "X = np.vstack([segment_1, segment_2, segment_3])\n",
        "\n",
        "# Manually store a few \"steps\" of k-means centers for visual presentation\n",
        "centers_step1 = np.array([[1.5, 1.5], [4.5, 8.5], [8.2, 3.0]])\n",
        "centers_step2 = np.array([[4.6, 2.8], [2.5, 6.8], [7.0, 5.4]])\n",
        "centers_final = np.array([[5.0, 2.0], [2.0, 7.0], [7.0, 6.0]])\n",
        "\n",
        "def assign_clusters(X, centers):\n",
        "    distances = np.sqrt(((X[:, None, :] - centers[None, :, :]) ** 2).sum(axis=2))\n",
        "    return distances.argmin(axis=1)\n",
        "\n",
        "labels_step1 = assign_clusters(X, centers_step1)\n",
        "labels_step2 = assign_clusters(X, centers_step2)\n",
        "labels_final = assign_clusters(X, centers_final)\n",
        "\n",
        "def clean_plot(title, labels=None, centers=None):\n",
        "    plt.figure(figsize=(7.2, 5.2))\n",
        "\n",
        "    if labels is None:\n",
        "        plt.scatter(X[:, 0], X[:, 1], s=55, alpha=0.75)\n",
        "    else:\n",
        "        plt.scatter(X[:, 0], X[:, 1], c=labels, s=55, alpha=0.75)\n",
        "\n",
        "    if centers is not None:\n",
        "        plt.scatter(\n",
        "            centers[:, 0],\n",
        "            centers[:, 1],\n",
        "            marker=\"X\",\n",
        "            s=280,\n",
        "            edgecolor=\"black\",\n",
        "            linewidth=1.2\n",
        "        )\n",
        "\n",
        "    plt.title(title, fontsize=18, pad=14)\n",
        "    plt.xlabel(\"Purchase Frequency\", fontsize=13)\n",
        "    plt.ylabel(\"Average Spending\", fontsize=13)\n",
        "    plt.xlim(0, 9)\n",
        "    plt.ylim(0, 9)\n",
        "    plt.grid(alpha=0.25)\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ],
